# Dependencies
node_modules/

# Build output
dist/
.vite/

# Data (personal/test content)
data/

# Test coverage reports
coverage/

# Playwright test artifacts
playwright-report/
test-results/

# AGENTS.md files are core to this project's architecture — always track them
# (overrides global gitignore rules that suppress AGENTS.md)
!**/AGENTS.md

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.sisyphus
.opencode/*

# But do allow the utilities
!/.opencode/skills
!/.opencode/commands

# Logs
*.log
logs/
npm-debug.log*

# Environment
.env
.env.local
.env.*.local

# TypeScript cache
*.tsbuildinfo

# Don't commit these without sanitizing first (PII risk)
**/tests/model/results/
**/*-ideal.json
**/*-ideal-response.json
api/config.php
local_cache
